# Test environment — safe to commit (no real secrets)
NODE_ENV=test
PORT=3000
ADMIN_PORT=3001

# MongoDB — dedicated test database, wiped between test runs
MONGODB_URI=mongodb://localhost:27017/dual-dictionary-test

# JWT — fixed secrets for reproducible test tokens
JWT_SECRET=test-jwt-secret-key-min-32-characters-x
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test-refresh-secret-key-min-32-chars-x
JWT_REFRESH_EXPIRES_IN=1d

# CORS
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# Mail — use Mailhog (docker: mailhog/mailhog) or Ethereal
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=info.dualdictionary.team@gmail.com
MAIL_PASS=rrwo ibpx tmlm ecnw
MAIL_FROM="Dual Dictionary <info.dualdictionary.team@gmail.com>"

# AWS — use LocalStack (docker: localstack/localstack)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=dual-dictionary-test

# Web App URL (used in password-reset emails)
WEB_APP_URL=http://localhost:4200
